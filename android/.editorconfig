root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
# Compose UI functions are PascalCase nouns.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Line length is enforced by detekt (production code only; test data has long JSON literals).
# ktlint still wraps lines at max_line_length when it formats, it just does not report the rest.
ktlint_standard_max-line-length = disabled
