# Copy to android/keystore.properties (git-ignored) and fill in. Never commit the real file or the .jks.
# CI does not use this file: it sets SCANFIT_UPLOAD_STORE_FILE / _STORE_PASSWORD / _KEY_ALIAS / _KEY_PASSWORD instead.
#
# Create the upload key once (keep the .jks and passwords in your password manager, outside the repo):
#   keytool -genkeypair -v -keystore ~/keys/scanfit-upload.jks -alias scanfit-upload \
#           -keyalg RSA -keysize 4096 -validity 9125
# Then enrol in Play App Signing when you create the app in Play Console (the upload key can be reset by Google if lost).
storeFile=/ABSOLUTE/PATH/TO/scanfit-upload.jks
storePassword=REPLACE_ME
keyAlias=scanfit-upload
keyPassword=REPLACE_ME

