    "error.export_verify_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved file didn't pass our check, so we removed it. Please save again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सेव की गई फ़ाइल हमारी जाँच में पास नहीं हुई, इसलिए हटा दी गई। कृपया दोबारा सेव करें।"
          }
        }
      }
    },
    "error.face_multiple": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one face found. Crop to one person."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक से ज़्यादा चेहरे मिले। केवल एक व्यक्ति तक क्रॉप करें।"
          }
        }
      }
    },
    "error.face_none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No face found. Retake the photo with your face clearly visible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चेहरा नहीं मिला। चेहरा साफ़ दिखे, ऐसी फ़ोटो दोबारा लें।"
          }
        }
      }
    },
    "error.fit_cannot_reach": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't get under %1$lld KB. Try fewer pages or crop the margins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld KB से कम नहीं हो पाई। कम पन्ने चुनें या किनारे क्रॉप करें।"
          }
        }
      }
    },
    "error.fit_too_detailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too detailed to fit in %1$lld KB. Try a plainer background or crop closer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld KB में फ़िट होने के लिए बहुत ज़्यादा डिटेल है। सादा बैकग्राउंड रखें या पास से क्रॉप करें।"
          }
        }
      }
    },
    "error.generic": {
      "extractionState": "manual",
      "localizations": {
