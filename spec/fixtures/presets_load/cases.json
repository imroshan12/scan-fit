{
  "_doc": "Run by Android (:core:presets) and iOS (Presets) unit tests. Files are in this directory. Each case must load (ok) or be refused for the stated reason. Generated by spec/tools/make_presets_load_cases.py.",
  "supported_schema_version": 2,
  "supported_failure_reasons": [
    "bad_schema",
    "stale_version",
    "parse"
  ],
  "load_cases": [
    {
      "id": "newer_version_accepted",
      "bundle": "sample_presets.json",
      "current_version": 6,
      "expect": "ok"
    },
    {
      "id": "first_install_accepted",
      "bundle": "sample_presets.json",
      "current_version": 0,
      "expect": "ok"
    },
    {
      "id": "same_version_rejected",
      "bundle": "sample_presets.json",
      "current_version": 7,
      "expect": "stale_version"
    },
    {
      "id": "older_version_rejected",
      "bundle": "sample_presets.json",
      "current_version": 9,
      "expect": "stale_version"
    },
    {
      "id": "unsupported_schema_rejected",
      "bundle": "schema3_presets.json",
      "current_version": 0,
      "expect": "bad_schema"
    },
    {
      "id": "garbage_rejected",
      "bundle": "malformed_presets.json",
      "current_version": 0,
      "expect": "parse"
    },
    {
      "id": "wrong_shape_rejected",
      "bundle": "bad_shape_presets.json",
      "current_version": 0,
      "expect": "parse"
    },
    {
      "id": "not_an_object_rejected",
      "bundle": "not_an_object.json",
      "current_version": 0,
      "expect": "parse"
    },
    {
      "id": "empty_file_rejected",
      "bundle": "empty.json",
      "current_version": 0,
      "expect": "parse"
    }
  ]
}
