			"id": "wrong_density",
			"operation": "wrong_dpi",
			"saved": false,
			"expect": { "available": false, "status": "not_started" }
		},
		{
			"id": "private_metadata",
			"operation": "exif",
			"saved": false,
			"expect": { "available": false, "status": "not_started" }
		},
		{
			"id": "unknown_record_version",
			"operation": "version",
			"saved": false,
			"expect": { "available": false, "status": "not_started" }
		},
		{
			"id": "saved_precedence",
			"operation": "valid",
			"saved": true,
			"expect": { "available": true, "status": "saved" }
		},
		{
			"id": "historical_saved_without_draft",
			"operation": "missing",
			"saved": true,
			"expect": { "available": false, "status": "saved" }
		}
