	"review_check_cases": [
		{
			"id": "exact",
			"verdict": "EXACT",
			"failed": [],
			"expect": [true, true, true]
		},
		{
			"id": "accepted_preferred_upscaled",
			"verdict": "ACCEPTED",
			"failed": [],
			"expect": [true, true, true]
		},
		{
			"id": "size_miss",
			"verdict": "NEAR_MISS",
			"failed": ["size_kb"],
			"expect": [false, true, true]
		},
		{
			"id": "dimensions_miss",
			"verdict": "NO",
			"failed": ["dims"],
			"expect": [true, false, true]
		},
		{
			"id": "format_miss",
			"verdict": "NEAR_MISS",
			"failed": ["format"],
			"expect": [true, true, false]
		},
		{
			"id": "encoding_miss",
			"verdict": "NEAR_MISS",
			"failed": ["encoding"],
			"expect": [true, true, false]
		},
		{
			"id": "multiple_misses",
			"verdict": "NO",
			"failed": ["size_kb", "dims", "encoding"],
			"expect": [false, false, false]
		},
		{
			"id": "unknown",
			"verdict": "UNKNOWN",
			"failed": [],
			"expect": [false, false, false]
		}
	],
	"fit_cases": [
		{
			"id": "ibps_photo_from_phone",
			"input": "photo_phone_3000x4000.jpg",
			"preset": "ibps_po",
			"doc": "photo",
			"crop": { "x": 700, "y": 700, "w": 1600, "h": 1840 },
			"expect": {
				"format": "jpeg_baseline",
				"color": "rgb",
				"kb_min": 20,
				"kb_max": 50,
				"width": 200,
				"height": 230,
				"allow_upscaled_preferred": true,
				"exif": "none",
				"max_ms_midrange": 800
			}
		},
		{
			"id": "ibps_signature_from_paper",
			"input": "signature_paper_shadow.jpg",
			"preset": "ibps_po",
			"doc": "signature",
			"pipeline": "signature_cleanup",
			"expect": {
				"format": "jpeg_baseline",
				"kb_min": 10,
				"kb_max": 20,
				"aspect": 2.333,
				"aspect_tol": 0.02,
				"background_mean_min": 235,
				"ink_pixels_min_pct": 1.0,
				"allow_upscaled_preferred": true
			}
		},
		{
			"id": "tiny_signature_hits_minimum",
			"input": "signature_clean_420x180.png",
			"preset": "ibps_po",
			"doc": "signature",
			"_why": "At 140x60 even q=100 is ~6 KB. Engine must use the minimum-size strategy (ALGORITHMS.md §1.4).",
			"expect": {
				"kb_min": 10,
				"kb_max": 20,
				"aspect": 2.333,
				"aspect_tol": 0.02,
				"decodes": true
			}
		},
		{
			"id": "ibps_thumb",
			"input": "thumb_ink.jpg",
			"preset": "ibps_po",
			"doc": "left_thumb",
			"pipeline": "thumb_cleanup",
			"expect": {
				"kb_min": 20,
				"kb_max": 50,
				"width": 240,
				"height": 240,
				"allow_upscaled_preferred": true,
				"dpi": 200
			}
		},
		{
			"id": "ibps_declaration",
			"input": "declaration_paper.jpg",
			"preset": "ibps_po",
			"doc": "handwritten_declaration",
			"pipeline": "document_cleanup",
			"expect": {
				"kb_min": 50,
				"kb_max": 100,
				"width": 800,
				"height": 400,
				"allow_upscaled_preferred": true,
				"dpi": 200
			}
		},
		{
			"id": "gate_photo_range",
			"input": "photo_phone_3000x4000.jpg",
			"preset": "gate",
			"doc": "photo",
			"expect": {
				"kb_min": 5,
				"kb_max": 600,
				"w_range": [200, 530],
				"h_range": [260, 690],
				"aspect_range": [0.66, 0.89]
			}
		},
		{
			"id": "gate_signature_range",
			"input": "signature_paper_shadow.jpg",
			"preset": "gate",
			"doc": "signature",
			"pipeline": "signature_cleanup",
			"expect": {
				"kb_min": 3,
				"kb_max": 300,
				"w_range": [250, 580],
				"h_range": [80, 180],
				"aspect_range": [2.75, 3.75]
			}
		},
		{
			"id": "jee_photo_filename",
			"input": "photo_phone_3000x4000.jpg",
			"preset": "jee_main",
			"doc": "photo",
			"expect": {
				"kb_min": 10,
				"kb_max": 200,
				"export_filename": "Photograph.jpg"
			}
		},
		{
			"id": "uppsc_photo_no_min",
			"input": "photo_phone_3000x4000.jpg",
			"preset": "uppsc",
			"doc": "photo",
			"expect": { "kb_max": 50, "dpi": 200 }
		},
		{
			"id": "exact_mode_pads_and_never_scales",
			"input": "signature_clean_420x180.png",
			"doc": "signature",
			"spec": {
				"type": "signature",
				"required": true,
				"formats": ["jpg"],
				"size_kb": { "min": 12, "max": 20, "target": 16 },
				"dimensions": { "mode": "exact", "width": 100, "height": 40 }
			},
			"_why": "No real preset uses exact mode. An exact slot can only be padded (ALGORITHMS 9.4): the pixel size must stay 100x40.",
			"expect": {
				"format": "jpeg_baseline",
				"kb_min": 12,
				"kb_max": 20,
				"width": 100,
				"height": 40,
				"decodes": true
			}
		},
		{
			"id": "pad_only_option_keeps_preferred_size",
			"input": "signature_clean_420x180.png",
			"preset": "ibps_po",
			"doc": "signature",
			"options": { "min_fill_strategy": "pad_only" },
			"expect": {
				"kb_min": 10,
				"kb_max": 20,
				"width": 140,
				"height": 60,
				"decodes": true
			}
		}
	],
