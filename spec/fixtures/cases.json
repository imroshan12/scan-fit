			"source": { "w": 700, "h": 100 },
			"expect": { "pad": { "w": 700, "h": 300, "x": 0, "y": 100 } }
		}
	],
	"crop_cases": [
		{
			"_doc": "Photo crop math (ALGORITHMS 9.6). image = decoded raster WxH; aspect = [w, h] of the slot. op frame: auto-framing from a face box (coverage optional, default 0.675) -> rect + coverage_adjusted. op move: dx/dy in raster px. op zoom: factor > 1 zooms in. Expectations are computed by spec/tools/photo_crop.py --write-cases.",
			"id": "frame_centred_face",
			"op": "frame",
			"image": { "w": 1000, "h": 1400 },
			"aspect": [200, 230],
			"face": { "x": 400, "y": 500, "w": 200, "h": 240 },
			"expect": {
				"rect": { "x": 307, "y": 426, "w": 386, "h": 444 },
				"coverage_adjusted": false
			}
		},
		{
			"id": "frame_shifted_back_inside",
			"op": "frame",
			"image": { "w": 1000, "h": 1400 },
			"aspect": [4, 5],
			"face": { "x": 10, "y": 20, "w": 200, "h": 240 },
			"expect": {
				"rect": { "x": 0, "y": 0, "w": 355, "h": 444 },
				"coverage_adjusted": false
			}
		},
		{
			"id": "frame_face_too_big_shrinks_and_flags",
			"op": "frame",
			"image": { "w": 1000, "h": 1200 },
			"aspect": [4, 5],
			"face": { "x": 50, "y": 100, "w": 900, "h": 1000 },
			"expect": {
				"rect": { "x": 20, "y": 0, "w": 960, "h": 1200 },
				"coverage_adjusted": true
			}
		},
		{
			"id": "frame_wide_slot_limited_by_width",
			"op": "frame",
			"image": { "w": 300, "h": 1000 },
			"aspect": [2, 1],
			"face": { "x": 0, "y": 0, "w": 400, "h": 100 },
			"expect": {
				"rect": { "x": 0, "y": 0, "w": 300, "h": 150 },
				"coverage_adjusted": true
			}
