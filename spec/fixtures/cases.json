{
	"_doc": "Cross-platform conformance cases. Both apps run every case in unit tests (Android: :core:imaging test, iOS: ImagingTests). Outputs need not be byte-identical across platforms; they must satisfy every assertion. Add real-photo cases under images/real/ (gitignored unless consented).",
	"export_cases": [
		{
			"id": "verified_destination",
			"operation": "success",
			"expect": { "state": "saved", "delete": false, "record": true }
		},
		{
			"id": "picker_cancelled",
			"operation": "cancel",
			"expect": { "state": "idle", "delete": false, "record": false }
		},
		{
			"id": "write_failed",
			"operation": "write_failed",
			"expect": {
				"state": "save_failed",
				"delete": true,
				"record": false
			}
		},
		{
			"id": "read_failed",
			"operation": "read_failed",
			"expect": {
				"state": "save_failed",
				"delete": true,
				"record": false
			}
		},
		{
			"id": "destination_corrupted",
			"operation": "corrupt",
			"expect": {
				"state": "verify_failed",
				"delete": true,
				"record": false
			}
		},
		{
			"id": "wrong_density",
			"operation": "wrong_dpi",
			"expect": {
				"state": "verify_failed",
				"delete": true,
				"record": false
			}
		},
		{
			"id": "private_metadata",
			"operation": "exif",
			"expect": {
				"state": "verify_failed",
				"delete": true,
				"record": false
			}
		},
		{
			"id": "publication_failed",
			"operation": "publish_failed",
			"expect": {
				"state": "save_failed",
				"delete": true,
				"record": false
			}
		}
	],
	"ink_preservation_cases": [
