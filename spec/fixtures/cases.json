	"patch_cases": [
		{
			"_doc": "JpegPatcher (1.5, 9.3). ok cases list what must hold on the output; error cases expect that typed error. pad_to_bytes applies pad() after patch().",
			"id": "strips_exif_gps_and_sets_dpi",
			"input": "photo_exif_gps_400x300.jpg",
			"dpi": 200,
			"expect": {
				"ok": true,
				"no_app1": true,
				"jfif": { "units": 1, "x": 200, "y": 200 },
				"sof": "SOF0",
				"components": 3,
				"decodes": true
			}
		},
		{
			"id": "dpi_comes_from_the_argument",
			"input": "photo_exif_gps_400x300.jpg",
			"dpi": 300,
			"expect": { "ok": true, "jfif": { "units": 1, "x": 300, "y": 300 } }
		},
		{
			"id": "removes_srgb_icc",
			"input": "icc_srgb_100x100.jpg",
			"dpi": 200,
			"expect": { "ok": true, "no_icc": true, "decodes": true }
		},
		{
			"id": "refuses_non_srgb_icc",
			"input": "icc_not_srgb_100x100.jpg",
			"dpi": 200,
			"expect_error": "NON_SRGB_PROFILE"
		},
		{
			"id": "refuses_progressive",
			"input": "progressive_200x230.jpg",
			"dpi": 200,
			"expect_error": "NOT_BASELINE"
		},
		{
			"id": "refuses_cmyk",
			"input": "cmyk_photo_200x230.jpg",
			"dpi": 200,
			"expect_error": "CMYK"
		},
		{
			"id": "refuses_png",
			"input": "png_named_as_jpg.jpg",
			"dpi": 200,
			"expect_error": "NOT_JPEG"
		},
		{
			"id": "gray_refused_by_default",
			"input": "gray_signature_140x60.jpg",
			"dpi": 200,
			"allow_grayscale": false,
			"expect_error": "GRAYSCALE_NOT_ALLOWED"
		},
		{
			"id": "gray_allowed_with_the_flag",
			"input": "gray_signature_140x60.jpg",
			"dpi": 200,
			"allow_grayscale": true,
			"expect": { "ok": true, "components": 1, "decodes": true }
		},
		{
			"id": "pad_reaches_the_exact_size",
			"input": "photo_exif_gps_400x300.jpg",
			"dpi": 200,
			"pad_to_bytes": 20000,
			"expect": {
				"ok": true,
				"size_bytes": 20000,
				"decodes": true,
				"sof": "SOF0"
			}
		}
	],
	"geometry_cases": [
		{
			"_doc": "Pure geometry (9.1, 9.4). Source is WxH. crop = default crop for photo kinds; start = fit start size; pad = pad-to-aspect canvas (ink kinds): {w,h,x,y}.",
			"id": "ibps_photo_default_crop",
			"preset": "ibps_po",
			"doc": "photo",
			"source": { "w": 3000, "h": 4000 },
			"expect": {
				"crop": { "x": 0, "y": 275, "w": 3000, "h": 3450 },
				"start": { "w": 200, "h": 230 }
			}
		},
		{
			"id": "gate_photo_range_midpoint",
			"preset": "gate",
			"doc": "photo",
			"source": { "w": 3000, "h": 4000 },
			"expect": {
				"crop": { "x": 0, "y": 64, "w": 3000, "h": 3871 },
				"start": { "w": 365, "h": 471 }
			}
		},
		{
			"id": "gate_signature_range_midpoint",
			"preset": "gate",
			"doc": "signature",
			"source": { "w": 2000, "h": 700 },
			"expect": { "start": { "w": 415, "h": 128 } }
