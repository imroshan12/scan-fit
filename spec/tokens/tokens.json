{
  "_doc": "Design tokens (UI_UX §4). Source of truth for ScanFitTheme.kt and Theme.swift: run spec/tools/gen_tokens.py. The generator fails if any text/background pair is < 4.5:1 or any icon/border pair is < 3:1. Brand is deep indigo, deliberately not government saffron/green.",

  "color": {
    "neutral": {
      "50": "#FAFAFC", "100": "#F1F1F5", "200": "#E3E3EA", "300": "#CFCFD9", "400": "#A4A4B4",
      "500": "#767689", "600": "#5A5A6B", "700": "#454553", "800": "#2E2E39", "900": "#1A1A21", "950": "#0E0E12"
    },
    "light": {
      "primary": "#3F4DB8", "onPrimary": "#FFFFFF",
      "primaryContainer": "#E1E4FF", "onPrimaryContainer": "#10186B",
      "background": "#FAFAFC", "onBackground": "#1A1A21",
      "surface": "#FFFFFF", "onSurface": "#1A1A21",
      "surfaceVariant": "#EDEDF3", "onSurfaceVariant": "#4A4A58",
      "outline": "#767689", "outlineVariant": "#CFCFD9",
      "success": "#1B7A3A", "onSuccess": "#FFFFFF",
      "successContainer": "#DDF2E2", "onSuccessContainer": "#0B3A1A",
      "warning": "#9A5A00", "onWarning": "#FFFFFF",
      "warningContainer": "#FFEFD0", "onWarningContainer": "#4A2A00",
      "error": "#BA1A1A", "onError": "#FFFFFF",
      "errorContainer": "#FFDAD6", "onErrorContainer": "#410002",
      "scrim": "#000000"
    },
    "dark": {
      "primary": "#B8C1FF", "onPrimary": "#141C73",
      "primaryContainer": "#2D3894", "onPrimaryContainer": "#DFE2FF",
      "background": "#121217", "onBackground": "#E4E4EC",
      "surface": "#1A1A21", "onSurface": "#E4E4EC",
      "surfaceVariant": "#2A2A34", "onSurfaceVariant": "#C5C5D3",
      "outline": "#8E8EA2", "outlineVariant": "#454553",
      "success": "#7ED79A", "onSuccess": "#00391A",
      "successContainer": "#0F4F27", "onSuccessContainer": "#B9F0CA",
      "warning": "#FFB95C", "onWarning": "#4A2900",
      "warningContainer": "#6A3D00", "onWarningContainer": "#FFDDB3",
      "error": "#FFB4AB", "onError": "#690005",
      "errorContainer": "#93000A", "onErrorContainer": "#FFDAD6",
      "scrim": "#000000"
    }
  },

  "type": {
    "_doc": "size in sp (Android) / pt (iOS, scales with Dynamic Type). figure = tabular numerals for '34 KB' style readouts.",
    "display":  { "size": 32, "weight": 700, "lineHeight": 40, "iosStyle": "largeTitle" },
    "title":    { "size": 22, "weight": 600, "lineHeight": 28, "iosStyle": "title2" },
    "headline": { "size": 18, "weight": 600, "lineHeight": 24, "iosStyle": "headline" },
    "body":     { "size": 16, "weight": 400, "lineHeight": 24, "iosStyle": "body" },
    "label":    { "size": 14, "weight": 500, "lineHeight": 20, "iosStyle": "subheadline" },
    "caption":  { "size": 12, "weight": 400, "lineHeight": 16, "iosStyle": "caption" },
    "figure":   { "size": 16, "weight": 600, "lineHeight": 24, "iosStyle": "body", "tabularNumbers": true }
  },

  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "layout": { "screenMargin": 16, "minTouchTargetAndroidDp": 48, "minTouchTargetIosPt": 44 },
  "radius": { "card": 16, "button": 12, "chip": 999 },

  "motion": {
    "durationMs": { "micro": 150, "standard": 250, "emphasised": 350 },
    "easing": { "standard": [0.2, 0.0, 0.0, 1.0], "emphasisedDecelerate": [0.05, 0.7, 0.1, 1.0] }
  }
}
